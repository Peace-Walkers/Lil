let a = 10
let b = 9

mut global = 0 

if global:
  let local = 20
  global = local + a + b 
  io::print("then case global: ")
  io::println(global)
else:
  let bouzelouf = 90
  global = bouzelouf + a + b
  io::print("else case global: ")
  io::println(global)

