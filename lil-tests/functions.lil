fn add(x, y):
  return x + y

let result = add(10, 5)

let table = {
  username: "oui",
  stats: {commit: 500},

  fn commit(self):
    return self.stats.commit
}

let name = table.username
let cmt  = table.commit()
let f_name = table.username[0]

type Option = 
  | Some(val)
  | None

let opt = Option::Some(table)
mut some = false

if opt == Option::Some(table):
  some = true
