let path = "build.zig"

let content = io::read(path)

let stat = fs::stat(path)
io::println(stat)

io::println("\n========[CONTENT]========\n")

match stat.kind:
  FileType::File => io::println("Is a file")
  FileType::Dir => io::println("Is a directory")
  FileType::Sym => io::println("Is a symlink")
  _ => io::println("Unkown type")


io::println("\n========[CONTENT]========\n")

io::println(content.content)



io::println("\n========[STRING PUSH TESTS]========\n")

mut str = "je test des truc"

io::print("before : ")
io::println(str)
io::print("len: ")
io::println(str.len())
io::println("")

str.push("s")

io::print("after : ")
io::println(str)
io::print("len: ")
io::println(str.len())


io::println("\n========[STRING SPLIT TESTS]========\n")

let splitted = content.content.split("\n")

let split_len = splitted.len()
mut i = 0

while i < split_len:
  io::print("line ")
  io::print(i)
  io::print(": ")
  io::println(splitted[i])
  i = i + 1

#io::println(splitted)
