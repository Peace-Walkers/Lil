fn! parse_http(raw_request):
  let parts = raw_request.split("\r\n\r\n")
  let head_part = parts[0]

  mut body = ""
  if parts.len() > 1:
    body = parts[1]

  let lines = head_part.split("\r\n")

  let request_line = lines[0].split(" ")
  let method = request_line[0]
  let path = request_line[1]

  let headers = map::new()

  mut i = 1
  while i < lines.len():
    let headers_lines = lines[i]

    let headers_parts = headers_lines.split(": ")

    if headers_parts.len() == 2:
      headers.put(headers_parts[0], headers_parts[1])

    i += 1

  let result = {
    method: method,
    path: path,
    headers: headers,
    body: body,
  }

  return result


let server = net::listen("0.0.0.0", 8080)?
io::println("Serveur HTTP démarré sur http://localhost:8080")

while true:
    let client = server.accept()?
    let req = client.recv()?
    
    let parsed = parse_http(req)?
    io::println("raw: {}", req)
    io::println("parsed: {}", parsed)
    
    let body = "<h1>Salut de la part de LiLang !</h1>"
    let response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 37\r\n\r\n"
    
    client.send(response)?
    client.send(body)?
